# HashSucker Plex VFS — canonical rclone mount definition.
#
# This file is the single source of truth for the production VFS mount.
# It reproduces the proven live configuration exactly (verified argv,
# verified behavior). Install with:
#
#   cp deploy/hashsucker-vfs.service ~/.config/systemd/user/hashsucker-vfs.service
#   systemctl --user daemon-reload
#   systemctl --user start hashsucker-vfs.service
#
# Requires the rclone remote `webdav-local:` pointing at the media-search
# WebDAV root, e.g.:
#
#   [webdav-local]
#   type = webdav
#   url = http://127.0.0.1:3000/vfs
#   vendor = other
#
# Flag provenance (do not tune blindly; each is measured):
#   --allow-other            Plex (different uid) must traverse the mount.
#   --dir-cache-time 60s     Directory membership freshness. New/removed
#                            publications appear within ~60s. Re-listing fires
#                            on expiry (verified); entry attrs stay on the
#                            60s attr cache and opens always live-GET, so a
#                            longer dir window cannot serve stale bytes.
#   --vfs-cache-mode minimal Streams ranges without full-file download.
#   --vfs-read-chunk-size 64M  WebDAV GET window (default 128M). Proven:
#                            abandonment is pervasive (Plex seeks/cancels
#                            constantly), and per-abandon upstream waste,
#                            permit occupancy, retry-storm surface and
#                            eviction blast radius all scale with the window
#                            (128MiB worst case vs 64MiB). Demand rate stays
#                            sane (16 GETs/GiB clean); 16M tested churnier
#                            with no benefit.
#   --vfs-read-chunk-size-limit 64M
#                            Cap the window: rclone otherwise doubles chunk
#                            size past the base on sustained reads
#                            (128MiB ranges observed on a 64M setting).
#   --attr-timeout 60s       Entry-attr cache. Sizes are immutable per
#                            published path; membership and negative misses
#                            stay on the dir cache, so 60s removes
#                            revalidation churn with no freshness regression
#                            (measured).
#   --log-level INFO + --log-file /tmp/rclone-mount.log
#                            Canonical logging. DEBUG only on scratch mounts.
# Deliberately NOT set (matches live, verified): --read-only (backend is
# read-only; kernel-level ro never engaged in production), --no-modtime,
# --buffer-size / --vfs-read-chunk-size / --vfs-read-ahead (defaults).
[Unit]
Description=HashSucker Plex VFS (rclone WebDAV mount)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=-/usr/bin/fusermount3 -uz /mnt/hashsucker-vfs
ExecStart=/usr/bin/rclone mount webdav-local: /mnt/hashsucker-vfs --allow-other --dir-cache-time 60s --vfs-cache-mode minimal --vfs-read-chunk-size 64M --vfs-read-chunk-size-limit 64M --attr-timeout 60s --log-level INFO --log-file /tmp/rclone-mount.log
ExecStop=-/usr/bin/fusermount3 -uz /mnt/hashsucker-vfs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
