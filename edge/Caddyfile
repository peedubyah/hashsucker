# Edge Proxy — HashSucker
# Routes HTTP traffic to internal services.
# See docs/architecture/EDGE-PROXY-CONTRACT.md

{
    # Disable TLS automation — deferred per contract §5.3
    auto_https off
    # Bind to all interfaces on the configured port
    http_port {$EDGE_PORT}
}

# Single site block — all routing in one place
:{$EDGE_PORT} {
    # -----------------------------------------------------------------------
    # /api/*  →  Control Plane
    # -----------------------------------------------------------------------
    @api path /api/*
    reverse_proxy @api media-search:3000 {
        header_up Range {http.request.header.Range}
        header_down -X-Resolver-*
        header_down -X-Internal-*
    }

    # -----------------------------------------------------------------------
    # /*  →  Resolver (stream redirects only — no media bytes)
    # Caddy fronts the /stream resolver which returns 307 redirects.
    # Media bytes flow directly from provider to client, never through Caddy.
    # -----------------------------------------------------------------------
    reverse_proxy media-search:3000 {
        # Active health checking against the existing /health endpoint.
        # Uses the actual response status; no separate health service.
        health_uri /health
        health_interval 2s
        health_timeout 1s
        health_status 2xx
        # Require 2 successes before marking healthy again
        health_passes 2
        # Passive health: require 2 consecutive failures before marking unhealthy
        max_fails 2

        header_down -X-Resolver-*
        header_down -X-Internal-*
    }

    # Access logging to stdout (JSON for container log aggregation)
    log {
        output stdout
        format json
    }
}
