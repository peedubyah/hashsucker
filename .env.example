# Unified media-stack environment configuration
# Copy to .env and fill in values before running docker compose up -d

# =============================================================================
# Shared
# =============================================================================
# Server-side TorBox API key (media-search cache checks + importer operations)
TORBOX_API_KEY=

# Shared request queue root on host (both services mount this at /requests)
REQUESTS_HOST_PATH=/mnt/database/appdata/media-request-queue

# =============================================================================
# media-search (Node search/request service)
# =============================================================================
# Stremio discovery addon manifest URL (WARNING: may contain embedded API key - never commit/log)
STREMIO_ADDON_MANIFEST_URL=

# Host port for media-search browser UI
MEDIA_SEARCH_PORT=3000

# Supplementary GID for queue filesystem access (matches queue group ownership)
MEDIA_SEARCH_QUEUE_GID=100

# =============================================================================
# torbox-importer (worker service)
# =============================================================================
# Runtime user/group for importer container
PUID=99
PGID=100

# Importer persistent state/scripts root on host (mounted at /config)
TORBOX_IMPORTER_HOST_PATH=/mnt/database/appdata/torbox-importer

# Download staging area on host
DOWNLOADS_HOST_PATH=/mnt/user/Downloads

# Polling interval in seconds
POLL_INTERVAL=10

# -----------------------------------------------------------------------------
# Radarr
# -----------------------------------------------------------------------------
RADARR_URL=http://192.168.1.5:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/data/Movies
RADARR_PROFILE_HD=4
RADARR_PROFILE_4K_WEB=7
RADARR_PROFILE_4K_BLU=8

# -----------------------------------------------------------------------------
# Sonarr
# -----------------------------------------------------------------------------
SONARR_URL=http://192.168.1.5:8989
SONARR_API_KEY=
