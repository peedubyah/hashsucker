# Unified media-stack environment configuration
# Copy to .env and fill in values before running docker compose up -d

# =============================================================================
# Provider Configuration
# =============================================================================
# TorBox API key (used for both search and importer)
TORBOX_API_KEY=
# Optional importer API base override, primarily for isolated testing
# TORBOX_API_URL=https://api.torbox.app/v1/api

# Real-Debrid API key (enables Real-Debrid provider discovery)
REALDEBRID_API_KEY=

# =============================================================================
# Live discovery manifests
# =============================================================================
# These only define discovery sources.
# Provider routing behavior comes later.
# =============================================================================

# Comet + TorBox (existing TorBox-backed Comet manifest)
COMET_TORBOX_MANIFEST_URL=

# Comet + Real-Debrid
COMET_REALDEBRID_MANIFEST_URL=

# Torrentio + TorBox (auto-generated from TORBOX_API_KEY when set)
# TORRENTIO_TORBOX_MANIFEST_URL=

# Torrentio + Real-Debrid (auto-generated from REALDEBRID_API_KEY when set)
# TORRENTIO_REALDEBRID_MANIFEST_URL=

# Torznab endpoints (JSON array of {id, name, url, role, enabled, sortOrder})
TORZNAB_URLS=

# Cinemeta base URL (optional, defaults to https://v3-cinemeta.strem.io)
# CINEMETA_BASE_URL=

# =============================================================================
# Shared Paths
# =============================================================================
# Shared request queue root on host (both services mount this at /requests)
REQUESTS_HOST_PATH=/mnt/database/appdata/media-request-queue

# Host bind paths for the media-search VFS volumes. The compose.override.yaml
# wires these into the media-search container (/data, /requests, /strm). Use
# relative paths (./hy4-data/...) on the dev workstation or absolute paths in
# production. DISCOVERY_HOST_PATH must point at the preserved discovery state.
DISCOVERY_HOST_PATH=./hy4-data/discovery
STRM_HOST_PATH=./hy4-data/strm

# =============================================================================
# media-search (UI + Node API service)
# =============================================================================
# Root Compose publishes the UI/API to loopback by default. Put an
# authenticated reverse proxy in front before using a non-loopback address.
MEDIA_SEARCH_BIND_ADDRESS=127.0.0.1
MEDIA_SEARCH_PORT=3000

# Supplementary GID for queue filesystem access (matches queue group ownership)
MEDIA_SEARCH_QUEUE_GID=100

# Root Compose stores DISCOVERY_DB=/data/discovery-cache.db in its
# discovery-data named volume. Local npm development still defaults to memory.

# Metadata cache settings (optional)
# METADATA_CACHE_TTL_MS=300000
# METADATA_CACHE_MAX_ENTRIES=500

# =============================================================================
# torbox-importer (worker service)
# =============================================================================
# Runtime user/group for importer container
PUID=99
PGID=100

# Importer persistent state/scripts root on host (mounted at /config)
TORBOX_IMPORTER_HOST_PATH=/mnt/database/appdata/torbox-importer

# Importer SQLite database path
TORBOX_DB=/config/state/torbox-importer.db

# Download staging area on host
DOWNLOADS_HOST_PATH=/mnt/user/Downloads

# Polling interval in seconds
POLL_INTERVAL=10

# =============================================================================
# Radarr
# =============================================================================
RADARR_URL=http://192.168.1.5:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/data/Movies
RADARR_PROFILE_HD=4
RADARR_PROFILE_4K_WEB=7
RADARR_PROFILE_4K_BLU=8

# =============================================================================
# Sonarr
# =============================================================================
SONARR_URL=http://192.168.1.5:8989
SONARR_API_KEY=
