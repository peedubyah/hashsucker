# Server-side secrets/configuration. Never expose these in browser code.
TORBOX_API_KEY=replace-with-torbox-api-key
STREMIO_ADDON_MANIFEST_URL=https://your-discovery-addon.example/manifest.json

# Unraid/Compose settings
MEDIA_SEARCH_PORT=3000
REQUESTS_HOST_PATH=/mnt/database/appdata/media-request-queue

# Optional direct-container settings (Compose supplies these defaults)
PORT=3000
HOST=0.0.0.0
REQUESTS_ROOT=/requests
