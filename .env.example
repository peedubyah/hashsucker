# Unified media-stack environment configuration
# Copy to .env and fill in values before running docker compose up -d

# =============================================================================
# Provider Configuration
# =============================================================================
# TorBox API key (used for both search and importer)
TORBOX_API_KEY=

# Real-Debrid API key (enables Real-Debrid provider discovery)
REALDEBRID_API_KEY=

# Optional: Manual Comet manifest URL (if not using Torrentio)
# COMET_MANIFEST_URL=

# Torznab endpoints (JSON array of {id, name, url, role, enabled, sortOrder})
TORZNAB_URLS=

# Cinemeta base URL (optional, defaults to https://v3-cinemeta.strem.io)
# CINEMETA_BASE_URL=

# =============================================================================
# Shared Paths
# =============================================================================
# Shared request queue root on host (both services mount this at /requests)
REQUESTS_HOST_PATH=/mnt/database/appdata/media-request-queue

# =============================================================================
# media-search (Node search/request service)
# =============================================================================
# Host port for media-search browser UI
MEDIA_SEARCH_PORT=3000

# Server bind host (defaults to 0.0.0.0)
HOST=0.0.0.0

# Server port (defaults to 3000, override if needed)
PORT=3000

# Supplementary GID for queue filesystem access (matches queue group ownership)
MEDIA_SEARCH_QUEUE_GID=100

# Discovery cache SQLite path (defaults to in-memory if unset)
# DISCOVERY_DB=/config/discovery-cache.db
# DISCOVERY_CACHE_PATH=/config/discovery-cache.db

# Metadata cache settings (optional)
# METADATA_CACHE_TTL_MS=300000
# METADATA_CACHE_MAX_ENTRIES=500

# =============================================================================
# torbox-importer (worker service)
# =============================================================================
# Runtime user/group for importer container
PUID=99
PGID=100

# Importer persistent state/scripts root on host (mounted at /config)
TORBOX_IMPORTER_HOST_PATH=/mnt/database/appdata/torbox-importer

# Importer SQLite database path
TORBOX_DB=/config/state/torbox-importer.db

# Download staging area on host
DOWNLOADS_HOST_PATH=/mnt/user/Downloads

# Polling interval in seconds
POLL_INTERVAL=10

# =============================================================================
# Radarr
# =============================================================================
RADARR_URL=http://192.168.1.5:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/data/Movies
RADARR_PROFILE_HD=4
RADARR_PROFILE_4K_WEB=7
RADARR_PROFILE_4K_BLU=8

# =============================================================================
# Sonarr
# =============================================================================
SONARR_URL=http://192.168.1.5:8989
SONARR_API_KEY=
