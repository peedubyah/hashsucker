# HashSucker on Unraid (Compose Manager)
#
# Copy to .env (same directory as compose.yaml), fill one provider key,
# then: docker compose pull && docker compose up -d
#
# Only the values below are normal-user decisions. Everything else stays
# at compose defaults. Advanced knobs live in .env.example.

# --- Release ---
# Stable channel (moves only on explicit releases). Pin to v0.1.0 etc.
# for an immutable deploy; `main` is the dev/dogfood channel (not for
# normal use).
HASHSUCKER_VERSION=latest

# --- Providers (REQUIRED: at least one of the two) ---
TORBOX_API_KEY=
# REALDEBRID_API_KEY=

# --- Paths (REQUIRED) ---
# Private state (SQLite, queue, importer state). Lives on appdata (cache
# pool); survives container recreation; back this share up.
HASHSUCKER_DATA_PATH=/mnt/user/appdata/hashsucker
# Consumer-visible media. Lives on a MEDIA share your Plex/Jellyfin can
# see; published .strm files land in <path>/strm. Tiny text files.
# This root NEVER stores media bytes.
HASHSUCKER_MEDIA_PATH=/mnt/user/media/hashsucker
# Owned-storage root for permanent promotion output (optional, off by
# default). Uncomment to enable POST /api/library/:id/promote; bytes
# here are owned media — back them up per your normal media policy.
# HASHSUCKER_PERMANENT_PATH=/permanent
# PERMANENT_HOST_PATH=/mnt/user/media/owned

# --- Ownership (Unraid default is correct; change only with reason) ---
PUID=99
PGID=100

# --- Ports (change only on conflict) ---
# MEDIA_SEARCH_PORT=3000
# EDGE_PORT=8080

# --- Optional request sources (absent = disabled, cleanly) ---
# Seerr = request signal (webhook token required to accept requests;
# URL/key only needed for TMDB identity resolution).
# SEERR_WEBHOOK_TOKEN=
# SEERR_URL=
# SEERR_API_KEY=
# Sonarr/Radarr = intent/catalog sensors (monitored reads only).
# RADARR_URL=
# RADARR_API_KEY=
# SONARR_URL=
# SONARR_API_KEY=

# --- Optional consumers (absent = no notification for that consumer) ---
# Plex/Jellyfin = library refresh targets (STRM files work regardless).
# PLEX_URL=
# PLEX_TOKEN=
# JELLYFIN_URL=
# JELLYFIN_API_KEY=
# JELLYFIN_MEDIA_ROOT=

# --- Optional candidate intelligence (absent = disabled, cleanly) ---
# Prowlarr = extra release candidates from indexers.
# PROWLARR_URL=
# PROWLARR_API_KEY=
