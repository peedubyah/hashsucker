# HashSucker on Unraid (Compose Manager)
#
# Copy to .env (same directory as compose.yaml), fill TORBOX_API_KEY,
# then: docker compose pull && docker compose up -d
#
# Only the values below are normal-user decisions. Everything else stays
# at compose defaults. Advanced knobs live in .env.example.

# --- Release ---
# Pin the published release (a tag like v0.1.0). Leave `latest` to track builds.
HASHSUCKER_VERSION=v0.1.0

# --- Provider (REQUIRED: the one credential HashSucker cannot run without) ---
TORBOX_API_KEY=

# --- Paths (REQUIRED) ---
# Private state (SQLite, queue, importer state). Lives on appdata (cache
# pool); survives container recreation; back this share up.
HASHSUCKER_DATA_PATH=/mnt/user/appdata/hashsucker
# Consumer-visible media. Lives on a MEDIA share your Plex/Jellyfin can
# see; published .strm files land in <path>/strm. Tiny text files.
HASHSUCKER_MEDIA_PATH=/mnt/user/media/hashsucker

# --- Ownership (Unraid default is correct; change only with reason) ---
PUID=99
PGID=100

# --- Ports (change only on conflict) ---
# MEDIA_SEARCH_PORT=3000
# EDGE_PORT=8080

# --- Optional second provider ---
# REALDEBRID_API_KEY=

# --- Optional request sources (absent = disabled, cleanly) ---
# SEERR_WEBHOOK_TOKEN=
# SEERR_URL=
# SEERR_API_KEY=
# RADARR_URL=
# RADARR_API_KEY=
# SONARR_URL=
# SONARR_API_KEY=

# --- Optional consumers (absent = no notification for that consumer) ---
# PLEX_URL=
# PLEX_TOKEN=
# JELLYFIN_URL=
# JELLYFIN_API_KEY=
# JELLYFIN_MEDIA_ROOT=

# --- Optional candidate intelligence ---
# PROWLARR_URL=
# PROWLARR_API_KEY=
