{
  "name": "media-search-restart-playback",
  "description": "Verify durable VFS identity survives a media-search-only restart.",
  "tier": 2,
  "target": { "media_type": "tv", "identity": "operator-selected", "season": "optional", "episode": "optional" },
  "required_start_state": "warm",
  "action": "snapshot identity and size; restart media-search; bounded read",
  "observers": ["control-plane", "vfs", "bytes", "provider-accounting"],
  "success": { "same_torrent_file_identity": true, "same_size": true, "bounded_read": true, "provider_429_delta": 0 },
  "budget": { "logical_requests": 0, "placement_create": 0 },
  "timeout": "120s",
  "cleanup_policy": "no publication mutation",
  "operator_authorization_required": true,
  "command": ["node", "benchmarks/proofs/resolver-adversarial-recovery-proof.js", "--case", "7"]
}
