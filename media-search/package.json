{
  "name": "hashsucker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch --env-file-if-exists=.env.local src/server/index.js",
    "search": "node --env-file=.env.local src/scripts/search.js",
    "stage3:report": "node src/scripts/stage3-fixture-report.js",
    "test": "node --test",
    "test:stage3": "node --test test/stage3-fixture-harness.test.js",
    "test:stage3:ranking": "STAGE3_RANKING_FIXTURE=1 node --test test/stage3-fixture-harness.test.js"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  }
}
